# Copia este archivo como .env y rellénalo (¡el .env no se sube nunca a git!)
# El token se pone mejor con ./poner-token.sh, que lo pide sin mostrarlo.
DISCORD_TOKEN=pega_aqui_el_token_del_bot
# Id del servidor de Discord y del canal del parte (Modo desarrollador → clic derecho → Copiar ID)
SERVIDOR_ID=
CANAL_PARTE_ID=
HORA_PARTE=07:30
# Opcional: id de un rol para mencionarlo en los avisos de "buen rato" (vacío = sin mención)
ROL_AVISO_ID=
# Canal privado para avisos del servidor (batería, corriente). Lo rellena crear-canal-servidor.py
CANAL_AVISOS_ID=
